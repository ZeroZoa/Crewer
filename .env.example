# 이 파일을 복사해 .env로 저장하고 실제 값으로 채워주세요.
# cp .env.example .env

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/crewer
DB_NAME=crewer
DB_USER=
DB_PASSWORD=

# JWT (256비트, 즉 32바이트 이상의 임의 문자열)
JWT_SECRET=

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# 이메일 인증 발송용 (Gmail 기준)
MAIL_USERNAME=
MAIL_PASSWORD=

# JPA 스키마 관리 전략 (update / validate / none 등)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 업로드 파일 저장 경로
UPLOAD_DIR=./uploads
